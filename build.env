# Build configuration, read by build.sh and the CI workflow.

# Packaging revision. The published version is <superwhisper version>-<PKG_REVISION>.
# Bump it to ship a manifest/script change for the same Superwhisper version; CI
# rebuilds when this file changes on main. It doesn't need resetting on upstream bumps.
PKG_REVISION=4

APP_ID=com.superwhisper.Superwhisper
FLATPAK_BRANCH=stable
FLATPAK_RUNTIME=org.gnome.Platform
FLATPAK_SDK=org.gnome.Sdk
FLATPAK_RUNTIME_VERSION=51
FLATPAK_REMOTE_URL=https://dl.flathub.org/repo/flathub.flatpakrepo
